[Unit]
Description=Robot Face Recognition Wake System
After=network-online.target
Wants=network-online.target
# 10 分钟内最多重启 5 次，超限后停止（放 [Unit] 以兼容旧版 systemd）
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_USER__

# 安装时由 install_face_service.sh 替换为 start_face.sh 的绝对路径（避免 %h 被展开为 /root）
ExecStart=/bin/bash __SCRIPT_PATH__

StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-face

# 安装时替换 __DEPLOY_HOME__ 为该用户实际 home，供脚本内 $HOME / conda 发现使用
Environment="HOME=__DEPLOY_HOME__"
Environment="PATH=__DEPLOY_HOME__/anaconda3/bin:__DEPLOY_HOME__/miniconda3/bin:__DEPLOY_HOME__/miniforge3/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

Restart=on-failure
RestartSec=30
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
